                elif c is S.false:
                    known.append(el)
                else:
                    unknown.append(el)
            if unknown:
                return Complement(FiniteSet(*(known + unknown)), self,
                                  evaluate=False)
            return FiniteSet(*known)
"""

assert old in src, "old block not found"
src = src.replace(old, new)
with open(path, 'w') as f:
