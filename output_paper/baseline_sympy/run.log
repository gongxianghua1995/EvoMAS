new = """        elif isinstance(other, FiniteSet):
            # other - self.  Remove the elements of other that are
            # definitely contained in self.  If containment of some
            # element cannot be determined (e.g. when it contains
            # symbols that could be assigned numbers lying in self)
            # then the result is left as a Complement so that the
            # uncertainty is preserved.
            known = []
            unknown = []
            for el in other:
                c = sympify(self.contains(el))
                if c is S.true:
