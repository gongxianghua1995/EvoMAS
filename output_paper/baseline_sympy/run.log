from sympy.physics.hep.gamma_matrices import GammaMatrix as G, gamma_trace, LorentzIndex
from sympy.physics.hep.gamma_matrices import kahane_simplify
from sympy.tensor.tensor import tensor_indices

def test_kahane_leading_gamma_matrix_bug():
    mu, nu, rho, sigma = tensor_indices("mu, nu, rho, sigma", LorentzIndex)

    t = G(mu)*G(-mu)*G(rho)*G(sigma)
    r = kahane_simplify(t)
    print(r)
    assert r.equals(4*G(rho)*G(sigma))

    t = G(rho)*G(sigma)*G(mu)*G(-mu)
    r = kahane_simplify(t)
    print(r)
    assert r.equals(4*G(rho)*G(sigma))

    # extra cases: single leading gamma, and multiple leading with an inner contraction
    t = G(rho)*G(mu)*G(-mu)
    r = kahane_simplify(t)
    print(r)
    assert r.equals(4*G(rho))

    t = G(mu)*G(-mu)
    r = kahane_simplify(t)
    print(r)

    # leading three indices
    t = G(rho)*G(sigma)*G(nu)*G(mu)*G(-mu)
    r = kahane_simplify(t)
    print(r)
    assert r.equals(4*G(rho)*G(sigma)*G(nu))

    print("ALL TESTS PASSED")

test_kahane_leading_gamma_matrix_bug()
