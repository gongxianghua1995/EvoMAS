def test_issue_12961():
    # hstack and vstack of matrices with zero rows/columns
    # should preserve the widths/heights of all matrices
    matrices = [SparseMatrix.zeros(0, n) for n in range(4)]
    assert SparseMatrix.hstack(*matrices).shape == (0, 6)

    matrices = [SparseMatrix.zeros(n, 0) for n in range(4)]
    assert SparseMatrix.vstack(*matrices).shape == (6, 0)

    M1 = SparseMatrix.zeros(0, 0)
    M2 = SparseMatrix.zeros(0, 1)
    M3 = SparseMatrix.zeros(0, 2)
    M4 = SparseMatrix.zeros(0, 3)
    assert SparseMatrix.hstack(M1, M2, M3, M4).shape == (0, 6)

    V1 = SparseMatrix.zeros(0, 0)
    V2 = SparseMatrix.zeros(1, 0)
    V3 = SparseMatrix.zeros(2, 0)
    V4 = SparseMatrix.zeros(3, 0)
    assert SparseMatrix.vstack(V1, V2, V3, V4).shape == (6, 0)
EOF
