from sympy import I
from sympy.polys import ring, QQ
from sympy.polys import factortools as ft
K = QQ.algebraic_field(I)

def my_ext_factor(f_expr):
    R, X, Y = ring('x,y', K)
    f = R.from_dict(f_expr)
    u = 1
    fd = f.to_dense()
    lc = ft.dmp_ground_LC(fd, u, K)
    F = ft.dmp_ground_monic(fd, u, K)
    s, g, r = ft.dmp_sqf_norm(F, u, K)  # use F instead of sqf_part
    factors = ft.dmp_factor_list_include(r, u, K.dom)
    print('  r factors:', [str(R.from_dense(fac)) + '^' + str(m) for fac, m in factors])
    if len(factors) == 1:
        res = [F]
    else:
        H = ft.dmp_raise([K.one, s*K.unit], u, 0, K)
        res = []
        for i, (factor, _) in enumerate(factors):
            h = ft.dmp_convert(factor, u, K.dom, K)
            h, _, g = ft.dmp_inner_gcd(h, g, u, K)
            h = ft.dmp_compose(h, H, u, K)
            res.append(h)
    res = ft.dmp_trial_division(F, res, u, K)
    out = []
    for fac, m in res:
        out.append((R.from_dense(fac), m))
    return lc, out

R, X, Y = ring('x,y', K)
f1 = dict((k, v) for (k, v) in ((X-1)**2*(Y-1)).terms())
f2 = dict((k, v) for (k, v) in ((X-1)*(Y-1)**2).terms())
