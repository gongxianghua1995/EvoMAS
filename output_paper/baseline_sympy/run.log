def test_product_of_sum_not_split():
    # Product of a sum is not the sum of the products of its
    # summands; it should be left unevaluated.
    p = Product(n + 2**(-k), (k, 0, n - 1)).doit()
    assert p == Product(n + 2**(-k), (k, 0, n - 1))
    assert p.subs(n, 2).doit() == Rational(15, 2)

