def _sqf_combine_factors(factors):
    """Combine factors of the same multiplicity in a square-free factorization.

    All factors that appear with the same multiplicity are multiplied together
    into a single factor.  For example, ``(x - 2)`` and ``(x - 3)`` both with
    multiplicity ``3`` are combined to give ``x**2 - 5*x + 6`` with
    multiplicity ``3``.  This makes the result of :func:`sqf_list` consistent
    with :meth:`Poly.sqf_list` which groups equal powers together.
    """
    if len(factors) < 2:
        return factors

