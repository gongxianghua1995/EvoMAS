import re

with open('sympy/stats/crv_types.py') as f:
    lines = f.readlines()

targets = [
    'ArcsinDistribution', 'DagumDistribution', 'FrechetDistribution',
    'GammaDistribution', 'GammaInverseDistribution', 'KumaraswamyDistribution',
    'LaplaceDistribution', 'LogisticDistribution', 'NakagamiDistribution',
    'StudentTDistribution', 'UniformSumDistribution',
]

for cls in targets:
    # find class line
    start = None
    for i, l in enumerate(lines):
        if re.match(r'^class %s\(' % cls, l):
            start = i
            break
    assert start is not None, cls
    # find the pdf def
    pdf_start = None
    for i in range(start, len(lines)):
        if re.match(r'^    def pdf\(self, x\):', lines[i]):
            pdf_start = i
            break
    assert pdf_start is not None, cls
    # find end of pdf: next line that does not start with 4 spaces followed by non-space
    # and is not blank
    end = pdf_start + 1
    while end < len(lines):
        l = lines[end]
        if l.strip() == '' or l.startswith('        ') or l.startswith('    '):
            end += 1
        else:
            break
    # back up over blank lines
    while end > pdf_start and lines[end-1].strip() == '':
        end -= 1
    print(cls, 'pdf at', pdf_start+1, 'ends at', end, 'next:', lines[end].strip()[:50])
