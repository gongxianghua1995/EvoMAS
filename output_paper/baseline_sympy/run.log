def _sqf_combine_factors(factors):
    """Combine factors of the same multiplicity.

    In the square-free factorization of a univariate polynomial all factors
    appearing with the same multiplicity are combined into a single factor.
    For example, ``(x - 2)*(x - 3)`` with multiplicity 3 combine to give
    ``x**2 - 5*x + 6`` with multiplicity 3.
    """
    if len(factors) < 2:
        return factors

    result, groups = [], {}
    for f, k in factors:
        if k.is_Integer:
            groups.setdefault(k, []).append(f)
        else:
            result.append((f, k))

    for k in sorted(groups, key=lambda exp: (exp.is_Integer, exp)):
        fs = groups[k]
        if len(fs) > 1:
            result.append((Mul(*fs).expand(), k))
        else:
            result.append((fs[0], k))

    return result
```

