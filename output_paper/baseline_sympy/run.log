def _combine_sqf_factors(factors):
    """Combine factors with same multiplicity for square-free factorization."""
    if not factors:
        return factors
    factors = sorted(factors, key=lambda x: x[1])  # sort by exp
    result = []
    i = 0
    while i < len(factors):
        f, k = factors[i]
        if k == 1:
            result.append((f, k))
            i += 1
            continue
        # collect all factors with same exp k
        combined = f
        j = i + 1
        while j < len(factors) and factors[j][1] == k:
            combined = combined.mul(factors[j][0])
            j += 1
        result.append((combined, k))
        i = j
    return result
```

