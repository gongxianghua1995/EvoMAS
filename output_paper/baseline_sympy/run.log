import re
path = 'sympy/polys/matrices/normalforms.py'
with open(path) as f:
    src = f.read()

old = """    # We work one row at a time, starting from the bottom row, and working our
    # way up. The total number of rows we will consider is min(m, n), where
    # A is an m x n matrix.
    m, n = A.shape
    rows = min(m, n)
    A = A.to_dense().rep.copy()
    # Our goal is to put pivot entries in the rightmost columns.
    # Invariant: Before processing each row, k should be the index of the
    # leftmost column in which we have so far put a pivot.
    k = n
    for i in range(m - 1, m - 1 - rows, -1):
        k -= 1"""

new = """    # We work one row at a time, starting from the bottom row, and working our
    # way up. We consider every row of the matrix: if the matrix has more rows
    # than columns (m > n) then pivots may need to be placed in one of the top
    # rows even after the bottom n rows have been processed (the bottom rows
    # might be zero).  The loop stops early once every column has been used for
    # a pivot (k == 0), since then no further pivots are possible.
    m, n = A.shape
    A = A.to_dense().rep.copy()
    # Our goal is to put pivot entries in the rightmost columns.
    # Invariant: Before processing each row, k should be the index of the
    # leftmost column in which we have so far put a pivot.
    k = n
    for i in range(m - 1, -1, -1):
        if k == 0:
            break
        k -= 1"""

assert old in src
src = src.replace(old, new)
with open(path, 'w') as f:
    f.write(src)
print("done")
