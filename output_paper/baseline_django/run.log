)
django.setup()

from django.db import connection

# Reproduce the loaddata scenario: a table named 'order' (SQL keyword)
with connection.cursor() as cursor:
    cursor.execute('DROP TABLE IF EXISTS "order"')
    cursor.execute('DROP TABLE IF EXISTS "item"')
    # 'order' is the keyword table; 'item' references it
    cursor.execute('CREATE TABLE "order" (id integer PRIMARY KEY)')
    cursor.execute('CREATE TABLE "item" (id integer PRIMARY KEY, order_id integer REFERENCES "order" (id))')
    # Insert an invalid foreign key reference
    cursor.execute('INSERT INTO "item" (id, order_id) VALUES (1, 999)')

# check_constraints should raise IntegrityError now (previously OperationalError)
try:
    with connection.constraint_checks_disabled():
        pass
    connection.check_constraints(table_names=['order', 'item'])
    print("NO ERROR RAISED - unexpected")
except Exception as e:
    print("Raised: %s: %s" % (type(e).__name__, e))
EOF
