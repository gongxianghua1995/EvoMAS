class DeleteQueryTests(TestCase):
    def test_delete_all_does_not_use_subquery(self):
        # .all().delete() must generate a plain DELETE FROM statement
        # without a subquery (regression for #31836).
        queryset = Avatar.objects.all()
        query = queryset.query.clone()
        query.__class__ = DeleteQuery
        sql, params = query.get_compiler(connection=connection).as_sql()
        self.assertEqual(sql, 'DELETE FROM "delete_avatar"')
        self.assertEqual(params, ())

    def test_delete_with_filter_does_not_use_subquery(self):
        # A simple filtered delete on a single table must also avoid the
        # subquery.
        queryset = Avatar.objects.filter(desc='missing')
        query = queryset.query.clone()
        query.__class__ = DeleteQuery
        sql, params = query.get_compiler(connection=connection).as_sql()
        self.assertEqual(sql, 'DELETE FROM "delete_avatar" WHERE "delete_avatar"."desc" = %s')
        self.assertEqual(params, ('missing',))

    def test_delete_with_join_uses_subquery(self):
        # Deleting rows identified through a join still requires the
        # subquery to avoid deleting from multiple tables accidentally.
        Avatar.objects.create(desc='a')
        queryset = User.objects.filter(avatar__desc='a')
        query = queryset.query.clone()
        query.__class__ = DeleteQuery
        sql, params = query.get_compiler(connection=connection).as_sql()
        self.assertIn('IN (SELECT ', sql)
        self.assertEqual(params, ('a',))
EOF
