import re

def get_pks_before(prefix, pk_name, post):
    pattern = re.compile(r'{}-\d+-{}$'.format(prefix, pk_name))
    return [value for key, value in post.items() if pattern.match(key)]

def get_pks_after(prefix, pk_name, post):
    pattern = re.compile(r'{}-\d+-{}$'.format(re.escape(prefix), re.escape(pk_name)))
    return [value for key, value in post.items() if pattern.match(key)]

# Prefix with regex special chars, e.g. from a custom formset prefix like "items[0]"
post = {
    'items[0]-0-id': '1',
    'items[0]-1-id': '2',
    'itemsx0-0-id': 'HACKED',  # matches the buggy regex 'items[0]' also matches 'itemsx0'
    'items1-0-id': 'ALSO_HACKED',  # 'items[0]' matches 'items1' since [0] means char class '0'
}
prefix = 'items[0]'
print("Before fix:", get_pks_before(prefix, 'id', post))
print("After fix :", get_pks_after(prefix, 'id', post))
print("pk name special:", get_pks_after('items', 'a.b', {'items-0-a.b': 'VALUE'}))
EOF
