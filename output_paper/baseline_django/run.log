import os, sqlite3, sys, tempfile
os.environ.setdefault('DJANGO_SETTINGS_MODULE', 'django.conf.global_settings')
import django
from django.conf import settings
if not settings.configured:
    settings.configure(INSTALLED_APPS=[], DATABASES={}, DEFAULT_AUTO_FIELD='django.db.models.AutoField')
django.setup()

from django.core.management import call_command
from django.db import connection
from io import StringIO

fd, path = tempfile.mkstemp(suffix='.sqlite3')
os.close(fd)
conn = sqlite3.connect(path)
conn.executescript("""
CREATE TABLE foo (id integer primary key, other_id int UNIQUE);
CREATE TABLE bar (
    id integer primary key,
    other_id int,
    CONSTRAINT myconst FOREIGN KEY(other_id) REFERENCES foo(other_id)
);
""")
conn.commit()
conn.close()

settings.DATABASES = {
    'default': {
        'ENGINE': 'django.db.backends.sqlite3',
        'NAME': path,
    }
}
# reset connection
connection.close()
connection.settings_dict = settings.DATABASES['default']
out = StringIO()
call_command('inspectdb', table=['bar'], stdout=out)
print(out.getvalue())
os.unlink(path)
EOF
