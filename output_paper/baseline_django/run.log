import os
from django.core.validators import URLValidator
from django.core.exceptions import ValidationError

v = URLValidator()
base = 'tests/validators'

def check(filename, expect_valid):
    bad = []
    with open(os.path.join(base, filename), encoding='utf8') as f:
        for line in f:
            url = line.strip()
            try:
                v(url)
                valid = True
            except ValidationError:
                valid = False
            if valid != expect_valid:
                bad.append((url, valid))
    return bad

bad_valid = check('valid_urls.txt', True)
bad_invalid = check('invalid_urls.txt', False)
print('valid_urls.txt mismatches (expected VALID):', len(bad_valid))
for u, v_ in bad_valid:
    print('  ', u, 'got', v_)
print('invalid_urls.txt mismatches (expected INVALID):', len(bad_invalid))
for u, v_ in bad_invalid:
    print('  ', u, 'got', v_)
print('DONE')
EOF
