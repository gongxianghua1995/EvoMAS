print("DIRECT IMPORTS:", direct_imports)
names = Status.__module__.split('.')
assert direct == "django.serializer_test_enum.Status['GOOD']" or direct.endswith("Status['GOOD']"), direct

# Serialize a CharField default using the enum
from django.db import models
class Item(models.Model):
    status = models.CharField(default=Status.GOOD, max_length=128)
    class Meta:
        app_label = 'testapp'

string, imports = MigrationWriter.serialize(Item._meta.get_field('status'))
print("SERIALIZED FIELD:", string)
print("IMPORTS:", imports)
assert "Status['GOOD']" in string, string
assert "Status['Good'" not in string and "Status('Good'" not in string, string
print("ALL OK")
EOF
