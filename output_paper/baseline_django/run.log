import django
from django.conf import settings
settings.configure(INSTALLED_APPS=[], DATABASES={}, DEFAULT_AUTO_FIELD='django.db.models.AutoField')
django.setup()

from django.db.models import DecimalField, IntegerField, ExpressionWrapper, F, Value
from django.db.models.functions import Mod
from django.db.models.expressions import CombinedExpression, Combinable

# Verify output_field resolution with mixed Decimal + Integer
lhs = ExpressionWrapper(Value(10, output_field=DecimalField()), output_field=DecimalField())
expr = Mod(lhs, F('x') * 2) if False else None

# Direct CombinedExpression test like Django's own tests
combined = CombinedExpression(
    ExpressionWrapper(Value(10), output_field=DecimalField()),
    Combinable.MOD,
    ExpressionWrapper(Value(3), output_field=IntegerField()),
)
print("Resolved output field:", combined._resolve_output_field())

combined2 = CombinedExpression(
    ExpressionWrapper(Value(10), output_field=IntegerField()),
    Combinable.MOD,
    ExpressionWrapper(Value(3), output_field=DecimalField()),
)
print("Resolved output field 2:", combined2._resolve_output_field())

combined3 = CombinedExpression(
    ExpressionWrapper(Value(10.5), output_field=DecimalField()),
    Combinable.MOD,
    ExpressionWrapper(Value(3), output_field=IntegerField()),
)
print("Resolved output field 3:", combined3._resolve_output_field())
EOF
