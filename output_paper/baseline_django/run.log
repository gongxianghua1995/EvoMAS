        new_index = models.Index(
            fields=self.old_fields,
            name=schema_editor._create_index_name(
                model._meta.db_table, columns, suffix="_idx"
            ),
        )
        schema_editor.rename_index(model, old_index, new_index)
        return
    ...
```

