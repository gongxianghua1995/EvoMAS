import io, sys
sys.path.insert(0, '.')
import django
from django.conf import settings
settings.configure(DEBUG=True, DATABASES={}, INSTALLED_APPS=[])
from django.core.management.base import OutputWrapper

# Simulate the actual issue: underlying stream buffers writes and flush has a side effect
class BufferedPipe:
    def __init__(self):
        self.lines = []
        self.flush_count = 0
    def write(self, msg):
        self.lines.append(msg)
    def flush(self):
        self.flush_count += 1

out = BufferedPipe()
w = OutputWrapper(out)
w.write("Operations to perform:")
w.write("Running migrations:")
w.flush()
assert out.flush_count == 1, "flush was not delegated to underlying stream"
print("OK: flush() delegates to underlying stream:", out.lines, "flush_count=", out.flush_count)
EOF
