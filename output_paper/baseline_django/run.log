import re

# Add __reversed__ method to OrderedSet
path = 'django/utils/datastructures.py'
with open(path) as f:
    content = f.read()

old = '''    def __len__(self):
        return len(self.dict)
'''

new = '''    def __len__(self):
        return len(self.dict)

    def __reversed__(self):
        return reversed(self.dict)
'''

assert old in content
content = content.replace(old, new, 1)
with open(path, 'w') as f:
    f.write(content)

# Add test
tpath = 'tests/utils_tests/test_datastructures.py'
with open(tpath) as f:
    tcontent = f.read()

told = '''    def test_len(self):
        s = OrderedSet()
        self.assertEqual(len(s), 0)
        s.add(1)
        s.add(2)
        s.add(2)
        self.assertEqual(len(s), 2)
'''

tnew = '''    def test_len(self):
        s = OrderedSet()
        self.assertEqual(len(s), 0)
        s.add(1)
        s.add(2)
        s.add(2)
        self.assertEqual(len(s), 2)

    def test_reversed(self):
        s = OrderedSet([1, 2, 3])
        self.assertEqual(list(reversed(s)), [3, 2, 1])
'''

assert told in tcontent
tcontent = tcontent.replace(told, tnew, 1)
with open(tpath, 'w') as f:
    f.write(tcontent)

print("done")
EOF
