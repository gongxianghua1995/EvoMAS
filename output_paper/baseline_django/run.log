from django.test.utils import isolate_apps
from django.db import models


class MtiParentLinkTests(TestCase):
    @isolate_apps('model_inheritance')
    def test_multiple_o2o_to_parent(self):
        class Document(models.Model):
            pass

        class Picking(Document):
            document_ptr = models.OneToOneField(
                Document,
                on_delete=models.CASCADE,
                parent_link=True,
                related_name='+',
            )
            origin = models.OneToOneField(
                Document,
                related_name='picking',
                on_delete=models.PROTECT,
            )

        # The parent link should be the explicit parent_link field, not origin.
        self.assertIs(Picking._meta.parents[Document], Picking._meta.get_field('document_ptr'))
        self.assertEqual(Picking._meta.get_field('document_ptr').remote_field.parent_link, True)
        self.assertEqual(Picking._meta.get_field('origin').remote_field.parent_link, False)
