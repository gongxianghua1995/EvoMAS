import django
from django.conf import settings
settings.configure(
    DEBUG=True,
    DATABASES={'default': {'ENGINE': 'django.db.backends.sqlite3', 'NAME': ':memory:'}},
    INSTALLED_APPS=[
        'django.contrib.contenttypes',
        'django.contrib.auth',
        'django.contrib.admin',
        'admin_changelist',
    ],
)
django.setup()
from django.db import connection
from django.db import models
from admin_changelist.models import Group, Concert, Musician

# Compare SQL: filter(Q1).filter(Q2) vs filter(Q1, Q2) using group__name
terms = ['one', 'two', 'three']
orm_lookups = ['group__name', 'name']

qs_loop = Concert.objects.all()
for bit in terms:
    or_queries = models.Q(*((orm_lookup, bit) for orm_lookup in orm_lookups), _connector=models.Q.OR)
    qs_loop = qs_loop.filter(or_queries)

qs_single = Concert.objects.filter(
    *[models.Q(*((orm_lookup, bit) for orm_lookup in orm_lookups), _connector=models.Q.OR) for bit in terms]
)

sql_loop, params_loop = qs_loop.query.sql_with_params()
sql_single, params_single = qs_single.query.sql_with_params()
print("LOOP SQL:")
print(sql_loop)
print()
print("SINGLE SQL:")
print(sql_single)
print()
print("Loop JOIN count:", sql_loop.lower().count('join '))
print("Single JOIN count:", sql_single.lower().count('join '))
EOF
