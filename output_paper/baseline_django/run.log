import django
from django.conf import settings

settings.configure(
    DEBUG=True,
    DATABASES={},
    INSTALLED_APPS=['django.contrib.contenttypes'],
    DEFAULT_AUTO_FIELD='django.db.models.AutoField',
)
django.setup()

from django.test.utils import isolate_apps

@isolate_apps('repro')
def run():
    from django.db import models
    from django.core import checks

    class Entity(models.Model):
        id = models.UUIDField(primary_key=True)
        class Meta:
            app_label = 'repro'

    class User(Entity):
        pass
        class Meta:
            app_label = 'repro'

    print("User pk auto_created:", User._meta.pk.auto_created)
    print("User parents:", User._meta.parents)

    orig = settings.is_overridden
    settings.is_overridden = lambda setting: (
        setting != 'DEFAULT_AUTO_FIELD' or
        settings.DEFAULT_AUTO_FIELD != 'django.db.models.AutoField'
    )
    try:
        errors = checks.run_checks(app_configs=None)
    finally:
        settings.is_overridden = orig
    for e in errors:
        print(e)
        print("---")
    return errors

errors = run()
print("Number of errors:", len(errors))
EOF
