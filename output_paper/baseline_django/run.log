import sys
sys.path.insert(0, '.')

import django
from django.conf import settings

settings.configure(
    DEBUG=True,
    DATABASES={'default': {'ENGINE': 'django.db.backends.sqlite3', 'NAME': ':memory:'}},
    INSTALLED_APPS=['django.contrib.contenttypes', 'django.contrib.auth', '__main__'],
)
django.setup()

from django.db import connection, models

class M(models.Model):
    f1 = models.IntegerField()
    f2 = models.IntegerField()
    f3 = models.IntegerField()
    class Meta:
        app_label = 'tests'

with connection.schema_editor() as se:
    se.create_model(M)

fields = M._meta.concrete_fields
objs = [M(f1=i, f2=i, f3=i) for i in range(200)]
max_batch_size = connection.ops.bulk_batch_size(fields, objs)
print('max_batch_size:', max_batch_size)

# User passes a batch_size larger than the backend's max batch size.
connection.queries_log.clear()
M.objects.bulk_create(objs, batch_size=1000)
queries = len(connection.queries_log)
print('number of INSERT queries with batch_size=1000:', queries)
expected = -(-200 // max_batch_size)  # ceil division
print('expected number of INSERT queries:', expected)

assert queries == expected, f'Expected {expected} queries, got {queries}'
print('PASS: batch_size was capped to compatible max batch size')
EOF
