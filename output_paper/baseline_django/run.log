class NaturalKeyAnchor2Manager(models.Manager):
    def get_by_natural_key(self, name):
        return self.get(name=name)


class NaturalKeyAnchor2(models.Model):
    name = models.CharField(max_length=100, unique=True)

    objects = NaturalKeyAnchor2Manager()

    def natural_key(self):
        return (self.name,)


class NaturalKeyThingWithFK(models.Model):
    title = models.CharField(max_length=100)
    anchor = models.ForeignKey(NaturalKeyAnchor2, models.CASCADE)

    class Manager(models.Manager):
        def get_by_natural_key(self, title, anchor):
            return self.get(title=title, anchor__name=anchor)

    objects = Manager()

    def natural_key(self):
        return (self.title,) + self.anchor.natural_key()

    natural_key.dependencies = ["serializers.naturalkeyanchor2"]

    class Meta:
        unique_together = [["title", "anchor"]]
