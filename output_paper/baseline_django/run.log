def test_add_nullable_unique_field(self):
    with connection.schema_editor() as editor:
        editor.create_model(Author)
        editor.create_model(BookWithoutAuthor)
    new_field = OneToOneField(Author, models.SET_NULL, null=True, blank=True, related_name="nullable_book")
    new_field.set_attributes_from_name("nullable_author")
    with connection.schema_editor() as editor:
        editor.add_field(BookWithoutAuthor, new_field)
    columns = self.column_classes(BookWithoutAuthor)
    self.assertIn('nullable_author_id', columns)
    self.assertTrue(columns['nullable_author_id'][1][6])
    counts = self.get_constraints_count(
        BookWithoutAuthor._meta.db_table,
        'nullable_author_id',
        (Author._meta.db_table, Author._meta.pk.column),
    )
    expected_fks = 1 if connection.features.supports_foreign_keys else 0
    self.assertEqual(counts, {'fks': expected_fks, 'uniques': 1, 'indexes': 0})
```

