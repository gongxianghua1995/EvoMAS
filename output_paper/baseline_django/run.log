import django
from django.conf import settings

settings.configure(
    DEBUG=True,
    DATABASES={
        "default": {
            "ENGINE": "django.db.backends.sqlite3",
            "NAME": ":memory:",
        }
    },
    INSTALLED_APPS=[
        "django.contrib.auth",
        "django.contrib.contenttypes",
        "django.contrib.sessions",
    ],
    AUTH_USER_MODEL="auth.User",
    DEFAULT_AUTO_FIELD="django.db.models.AutoField",
)
django.setup()

from django.contrib.auth.forms import UserCreationForm
from django.contrib.auth.models import User
from django.core.management import call_command

call_command("migrate", run_syncdb=True, verbosity=0)

# Create a group and attempt to assign via M2M through the form
from django.contrib.auth.models import Group
g1 = Group.objects.create(name="workers")
g2 = Group.objects.create(name="managers")

class GroupUserCreationForm(UserCreationForm):
    class Meta(UserCreationForm.Meta):
        model = User
        fields = ("username", "groups")

form = GroupUserCreationForm(data={
    "username": "testuser",
    "password1": "super_secret_123",
    "password2": "super_secret_123",
    "groups": [g1.pk, g2.pk],
})
print("is_valid:", form.is_valid())
if form.is_valid():
    user = form.save()
    print("user groups:", list(user.groups.values_list("name", flat=True)))
    assert set(user.groups.values_list("name", flat=True)) == {"workers", "managers"}, "M2M NOT SAVED!"
    print("SUCCESS: M2M saved correctly")
else:
    print("errors:", form.errors)
EOF
