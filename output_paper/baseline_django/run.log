# Minimal stub for cgi module removed in Python 3.13, for running old Django tests.
def parse_header(line):
    parts = line.split(';')
    key = parts[0]
    pdict = {}
    for p in parts[1:]:
        if '=' in p:
            k, v = p.split('=', 1)
            pdict[k.strip().lower()] = v.strip().strip('"')
    return key, pdict

def valid_boundary(s):
    return bool(s) and len(s) <= 200 and s.strip() == s and not s.startswith(' ')
