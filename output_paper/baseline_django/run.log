        self.value = value
    def match(self, ttype, value=None):
        return self.ttype == ttype and (value is None or self.value == value)
    def __iter__(self):
        return iter([])
class _Parsed:
    def __iter__(self):
        return iter([])
def parse(s):
    return [_Parsed()]
sqlparse.tokens = Tokens()
sqlparse.Token = Token
sqlparse.parse = parse
sys.modules['sqlparse'] = sqlparse
