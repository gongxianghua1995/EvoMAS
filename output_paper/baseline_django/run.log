    @skipUnlessDBFeature('supports_pragma_foreign_key_check')
    def test_check_constraints_keyword_table_name(self):
        """
        Constraint checks should quote table names that are SQL keywords.
        """
        with transaction.atomic():
            with connection.cursor() as cursor:
                cursor.execute('CREATE TABLE "order" (id integer PRIMARY KEY)')
                cursor.execute(
                    'CREATE TABLE "order_item" (id integer PRIMARY KEY, order_id integer REFERENCES "order" (id))'
                )
                cursor.execute('INSERT INTO "order" (id) VALUES (1)')
                with connection.constraint_checks_disabled():
                    cursor.execute('INSERT INTO "order_item" (id, order_id) VALUES (1, 42)')
                    with self.assertRaises(IntegrityError):
                        connection.check_constraints(table_names=['order', 'order_item'])
            transaction.set_rollback(True)
```

