import sys, types, datetime as dt

class UTC(dt.tzinfo):
    def utcoffset(self, dt): return dt.timedelta(0)
    def tzname(self, dt): return 'UTC'
    def dst(self, dt): return dt.timedelta(0)

_utc = UTC()

def _timezone(name):
    if name in ('UTC', 'utc'):
        return _utc
    raise NotImplementedError(name)

pytz = types.ModuleType('pytz')
pytz.utc = _utc
pytz.timezone = _timezone
sys.modules['pytz'] = pytz

# cgi stub
cgi = types.ModuleType('cgi')
def escape(s, quote=None):
    s = s.replace('&', '&amp;').replace('<', '&lt;').replace('>', '&gt;')
    if quote:
        s = s.replace('"', '&quot;')
    return s
def parse_header(line):
    parts = line.split(';')
    key = parts[0].strip().strip('"')
    pdict = {}
    for p in parts[1:]:
        if '=' in p:
            k, v = p.split('=', 1)
            pdict[k.strip()] = v.strip().strip('"')
    return key, pdict
cgi.escape = escape
cgi.parse_header = parse_header
sys.modules['cgi'] = cgi
EOF
