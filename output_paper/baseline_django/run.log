import re
import email.parser

def parse_header(line):
    parts = line.split(';')
    key = parts[0].strip()
    params = {}
    for p in parts[1:]:
        if '=' in p:
            k, v = p.split('=', 1)
            params[k.strip().lower()] = v.strip().strip('"').strip("'")
    return key, params

def valid_boundary(s):
    if not s:
        return False
    return bool(re.match(r'^[ -~]{0,200}[!-~]$', s))

def parse_qs(qs, *a, **kw):
    from urllib.parse import parse_qs as p
    return p(qs, *a, **kw)

def parse_multipart(fp, pdict, encoding='utf-8', errors='replace'):
    raise NotImplementedError

def parse_qsl(qs, *a, **kw):
    from urllib.parse import parse_qsl as p
    return p(qs, *a, **kw)
EOF
