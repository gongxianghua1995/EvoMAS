import subprocess, sys, select, os

code = '''
import sys, time
sys.path.insert(0, ".")
import django
from django.conf import settings
settings.configure(DEBUG=True, DATABASES={}, INSTALLED_APPS=[])
from django.core.management.base import OutputWrapper
out = OutputWrapper(sys.stdout)
out.write("first line")
out.flush()
time.sleep(0.5)
out.write("second line")
'''

# Use a pipe with a small buffer; write first line, flush, expect it read before process exits.
p = subprocess.Popen([sys.executable, '-c', code], stdout=subprocess.PIPE, stderr=subprocess.PIPE)
# read first line non-blockingly-ish
r, _, _ = select.select([p.stdout], [], [], 1.0)
if r:
    data = os.read(p.stdout.fileno(), 100)
    print("Read before process exit:", repr(data))
    assert b"first line" in data, "first line not flushed!"
else:
    print("No data available before process exit! flush() broken")
    assert False
p.wait()
print("PASS")
EOF
