import django
django.setup()

from pathlib import Path
from unittest import mock

from django.template import autoreload
from django.test import override_settings

with override_settings(TEMPLATES=[{
    "BACKEND": "django.template.backends.django.DjangoTemplates",
    "DIRS": [""],
}]):
    dirs = autoreload.get_template_directories()
    print("directories:", dirs)
    # The bug: cwd would be included, so any file change matches.
    assert Path.cwd() not in dirs, "FAIL: cwd present in template dirs (bug)"
    # template_changed should not return True for a random project file.
    with mock.patch("django.template.autoreload.reset_loaders") as mock_reset:
        result = autoreload.template_changed(None, Path(__file__))
        print("template_changed result:", result)
        assert result is None, "FAIL: template_changed unexpectedly True"
        mock_reset.assert_not_called()

print("PASS")
