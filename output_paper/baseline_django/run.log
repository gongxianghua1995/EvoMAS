new_test = '''
    def test_inlineformset_factory_preserves_default_pk_value(self):
        # A parent's default value (e.g. UUID) must not be cleared when the
        # inline formset is constructed/validated, otherwise saving the parent
        # in the admin would attempt to insert NULL for a non-auto field.
        FormSet = inlineformset_factory(
            ParentWithUUIDAlternateKey, ChildRelatedViaAK, fields="__all__"
        )
        parent = ParentWithUUIDAlternateKey(name="Parent")
        formset = FormSet(instance=parent)
        # Constructing the forms used to mutate the parent instance.
        formset.forms
        self.assertIsNotNone(parent.uuid)
        self.assertIsNone(formset.forms[0].fields["parent"].initial)
'''
with open(path, 'a') as f:
    f.write(new_test)
print("done")
