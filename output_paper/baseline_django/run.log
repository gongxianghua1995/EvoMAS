import django
from django.conf import settings

settings.configure(
    DEBUG=True,
    DATABASES={
        'default': {
            'ENGINE': 'django.db.backends.sqlite3',
            'NAME': ':memory:',
        }
    },
    INSTALLED_APPS=['django.contrib.contenttypes', 'django.contrib.auth'],
)
django.setup()

from django.db import models, connection, transaction

class Parent(models.Model):
    name = models.CharField(max_length=20)
    class Meta:
        app_label = 'repro'

class Child(models.Model):
    name = models.CharField(max_length=20)
    parent = models.OneToOneField(Parent, null=True, blank=True, on_delete=models.SET_NULL, related_name='child')
    class Meta:
        app_label = 'repro'

with connection.schema_editor() as editor:
    editor.create_model(Parent)
    editor.create_model(Child)

# Now drop the field as if it didn't exist, then add it via add_field
with connection.schema_editor() as editor:
    editor.remove_field(Child, Child._meta.get_field('parent'))

new_field = models.OneToOneField(Parent, null=True, blank=True, on_delete=models.SET_NULL, related_name='child2')
new_field.set_attributes_from_name('parent')
with connection.schema_editor() as editor:
    editor.add_field(Child, new_field)

print("SUCCESS: added nullable OneToOneField")
EOF
