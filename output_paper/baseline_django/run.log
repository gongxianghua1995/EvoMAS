        the_future = datetime(2100, 10, 25, 0, 00)
        self.assertEqual(dateformat.format(the_future, r'Y'), '2100')'''
new = '''    def test_futuredates(self):
        the_future = datetime(2100, 10, 25, 0, 00)
        self.assertEqual(dateformat.format(the_future, r'Y'), '2100')

    def test_y_format_for_year_before_1000(self):
        self.assertEqual(dateformat.format(datetime(123, 4, 5, 6, 7), 'y'), '23')
        self.assertEqual(dateformat.format(datetime(5, 4, 5, 6, 7), 'y'), '05')
        self.assertEqual(dateformat.format(datetime(999, 4, 5), 'y'), '99')
        self.assertEqual(dateformat.format(datetime(1000, 4, 5), 'y'), '00')'''
assert old in src
src = src.replace(old, new)
open(path, 'w').write(src)
print("test added")
EOF
