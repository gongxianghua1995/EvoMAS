@skipUnlessDBFeature('supports_table_check_constraints')
def test_check_constraint_with_boolean_complex_expression(self):
    constraint = models.CheckConstraint(
        check=(
            models.Q(price__gt=models.F('discounted_price')) &
            models.Q(color__isnull=False)
        ) | models.Q(color__isnull=True),
        name='complex_check',
    )
    with connection.schema_editor() as schema_editor:
        check_sql = constraint._get_check_sql(Product, schema_editor)
    self.assertNotIn(Product._meta.db_table, check_sql)
