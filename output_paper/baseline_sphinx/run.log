#!/usr/bin/env python3
import sys, re
# Fake graphviz 'dot': parse URL="..." attributes from input and emit an SVG
data = sys.stdin.read()
urls = re.findall(r'URL="([^"]*)"', data)
svg = ['<?xml version="1.0" encoding="UTF-8"?>',
       '<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="100" height="100">']
for u in urls:
    svg.append(f'<a xlink:href="{u}"><text>link</text></a>')
svg.append('</svg>')
sys.stdout.write('\n'.join(svg))
EOF
