from sphinx.extension import verify_needs_extensions
from sphinx.errors import VersionRequirementError

class Extension:
    def __init__(self, version):
        self.version = version

class App:
    def __init__(self, versions):
        self.extensions = versions

class Config:
    def __init__(self, needs):
        self.needs_extensions = needs

def expect_raise(app, cfg, desc):
    try:
        verify_needs_extensions(app, cfg)
        print("FAIL:", desc, "- no error raised")
    except VersionRequirementError:
        print("PASS:", desc, "- correctly raised")

def expect_ok(app, cfg, desc):
    verify_needs_extensions(app, cfg)
    print("PASS:", desc, "- accepted")

expect_ok(App({'sphinx_gallery.gen_gallery': Extension('0.10.0')}),
          Config({'sphinx_gallery.gen_gallery': '0.6'}),
          "0.10.0 accepted with min 0.6 (reported bug)")
