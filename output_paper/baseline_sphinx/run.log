def signature_from_str(signature: str) -> inspect.Signature:
    """Create a Signature object from string."""
    module = ast.parse('def func' + signature + ': pass')
    definition = cast(ast.FunctionDef, module.body[0])  # type: ignore

    # parameters
    args = definition.args
    params = []

    all_args = []
    if hasattr(args, "posonlyargs"):
        for arg in args.posonlyargs:  # type: ignore
            all_args.append((arg, Parameter.POSITIONAL_ONLY))
    for arg in args.args:
        all_args.append((arg, Parameter.POSITIONAL_OR_KEYWORD))

    for i, (arg, kind) in enumerate(all_args):
        if len(all_args) - i <= len(args.defaults):
            default = ast_unparse(args.defaults[-len(all_args) + i])
        else:
            default = Parameter.empty

        annotation = ast_unparse(arg.annotation) or Parameter.empty
        params.append(Parameter(arg.arg, kind, default=default, annotation=annotation))

    if args.vararg:
    
