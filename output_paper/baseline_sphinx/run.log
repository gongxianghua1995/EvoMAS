"""Minimal imghdr replacement for Python 3.13+ (stdlib module removed)."""
import struct

tests = []

def what(file, h=None):
    f = None
    try:
        if h is None:
            if isinstance(file, (str, bytes)):
                f = open(file, 'rb')
                h = f.read(32)
            else:
                location = file.tell() if hasattr(file, 'tell') else 0
                h = file.read(32)
                if hasattr(file, 'seek'):
                    file.seek(location)
        if not h:
            return None
        if h.startswith(b'\x89PNG\r\n\x1a\n'):
            return 'png'
        if h[:2] == b'\xff\xd8':
            return 'jpeg'
        if h[:6] in (b'GIF87a', b'GIF89a'):
            return 'gif'
        if h[:4] == b'RIFF' and h[8:12] == b'WEBP':
            return 'webp'
        if h.startswith(b'BM'):
            return 'bmp'
        if h[:4] == b'II*\x00' or h[:4] == b'MM\x00*':
            return 'tiff'
        if h.startswith(b'8BPS'):
            return 'psd'
        if h[:4] == b'\x00\x00\x01\x00':
            return 'ico'
        if h[:4] == b'\x00\x00\x02\x00':
            return 'cur'
        return None
    except Exception:
        return None
    finally:
        if f is not None:
            f.close()
EOF
