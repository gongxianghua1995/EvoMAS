expect_raise(App({'ext': Extension('1.0-rc1')}), Config({'ext': '2.0'}), "non-PEP440 fallback lexical raise")
expect_ok(App({'ext': Extension(5)}), Config({'ext': 5}), "non-string equal ok")
expect_ok(App({'ext': Extension('1.0')}), Config({'ext': '1.0.0'}), "1.0 >= 1.0.0 accepted")
print("ALL TESTS DONE")
EOF
