"""Minimal imghdr stub for Python 3.13+ where imghdr was removed."""
import struct

tests = []

def what(file, h=None):
    if h is None:
        if isinstance(file, str):
            with open(file, 'rb') as f:
                h = f.read(32)
        else:
            try:
                h = file.read(32)
            except AttributeError:
                return None
    for test in tests:
        res = test(h, None)
        if res is not None:
            return res
    return None

def test_jpeg(h, f):
    if h[6:10] in (b'JFIF', b'Exif'):
        return 'jpeg'

def test_png(h, f):
    if h.startswith(b'\211PNG\r\n\032\n'):
        return 'png'

def test_gif(h, f):
    if h[:6] in (b'GIF87a', b'GIF89a'):
        return 'gif'

tests.extend([test_jpeg, test_png, test_gif])
EOF
