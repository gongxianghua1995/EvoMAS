@contextmanager
def warns(warning, match):
    match_re = re.compile(match)
    try:
        yield warning
    finally:
        raw_warnings = warning.getvalue()
        warnings = [w for w in raw_warnings.split("\n") if w.strip()]

        assert len(warnings) == 1 and all(match_re.match(w) for w in warnings)
        warning.truncate(0)


