def _parse_field_arg(arg: str) -> Tuple[str, str]:
    """Parse an argument for a field.

    The argument can have the form ``type name`` or ``name``.  In the former
    case, the type is returned as well as the name.
    """
    if ' ' not in arg:
        return '', arg

    # The type can contain spaces (e.g. ``dict(str, str)``).  The name is
    # always the last whitespace-delimited token because Python identifiers
    # cannot contain spaces.
    argtype, argname = arg.rsplit(None, 1)
    return argtype, argname

