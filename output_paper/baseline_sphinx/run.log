    # other private members should NOT be documented
    # (there are no other underscore-prefixed members in Class)


@pytest.mark.sphinx('html', testroot='ext-autodoc')
def test_private_members_flag_all(app):
    app.config.autoclass_content = 'class'
    options = {"members": None,
               "undoc-members": True,
               "private-members": None}
    actual = do_autodoc(app, 'class', 'target.Class', options)
    documented = [line for line in actual if '::' in line]
    print("DOCUMENTED ALL:", documented)
    assert '   .. py:attribute:: Class._private_inst_attr' in documented
EOF
