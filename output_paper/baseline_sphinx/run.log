In Sphinx, they added:
```python
class ASTUserDefinedLiteral(ASTLiteral):
    def __init__(self, base: ASTLiteral, suffix: str) -> None:
        self.base = base
        self.suffix = suffix

    def _stringify(self, transform: StringifyTransform) -> str:
        return '%s%s' % (self.base, self.suffix)

    def get_id(self, version: int) -> str:
        # user defined literal is just a literal with a suffix
        return self.base.get_id(version)[:-1] + self.suffix + 'E'

    def describe_signature(self, signode: TextElement, mode: str,
                           env: "BuildEnvironment", symbol: "Symbol") -> None:
        self.base.describe_signature(signode, mode, env, symbol)
        signode.append(nodes.Text(self.suffix, self.suffix))
