"""Minimal imghdr shim for Python 3.13+ where imghdr was removed."""
def what(file, h=None):
    if h is None:
        if hasattr(file, 'read'):
            h = file.read(32)
        else:
            with open(file, 'rb') as f:
                h = f.read(32)
    if h.startswith(b'\x89PNG\r\n\x1a\n'):
        return 'png'
    if h.startswith(b'\xff\xd8'):
        return 'jpeg'
    if h.startswith(b'GIF87a') or h.startswith(b'GIF89a'):
        return 'gif'
    if h.startswith(b'%PDF'):
        return 'pdf'
    if h.startswith(b'%!PS'):
        return 'ps'
    if h.startswith(b'\x00\x00\x01\x00'):
        return 'ico'
    return None

tests = []
def test_svg(h, f):
    try:
        import xml.etree.ElementTree as ET
        ET.fromstring(h.decode('utf-8'))
        return 'svg'
    except Exception:
        return None
EOF
