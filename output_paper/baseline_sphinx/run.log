from unittest import mock
import pytest
import requests


def _resp(url, status, body, headers=None):
    resp = requests.Response()
    resp.status_code = status
    resp.url = url
    resp._content = body
    resp.headers = headers or {}
    resp.request = requests.Request('GET', url).prepare()
    return resp


@pytest.mark.sphinx('linkcheck', testroot='linkcheck-anchor404', freshenv=True)
def test_anchor_404_reports_http_error(app, status, warning):
    def fake_get(url, **kwargs):
        return _resp(url, 404, b"<html><body>404</body></html>")

    with mock.patch('requests.get', side_effect=fake_get):
        app.builder.build_all()

    content = (app.outdir / 'output.txt').read_text()
    print(content)
    assert "404 Client Error" in content
    assert "Anchor" not in content


@pytest.mark.sphinx('linkcheck', testroot='linkcheck-anchor404', freshenv=True)
def test_anchor_200_missing_anchor_still_reports(app, status, warning):
    def fake_get(url, **kwargs):
        return _resp(url, 200, b"<html><body>no anchor here</body></html>")

    with mock.patch('requests.get', side_effect=fake_get):
        app.builder.build_all()

    content = (app.outdir / 'output.txt').read_text()
    print(content)
    assert "Anchor 'test' not found" in content
EOF
