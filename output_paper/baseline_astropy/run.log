def _format_float(value):
    """Format a floating number to make sure it gets the decimal point."""
    # Use Python's built-in string representation of floats, which uses the
    # shortest string that round-trips to the same value (see issue #5449),
    # rather than forcing a specific number of significant digits which can
    # produce unnecessarily long representations (e.g. 0.009124999999999999
    # instead of 0.009125).
    value_str = str(value)
    if "." not in value_str and "e" not in value_str.lower():
        value_str += ".0"
    elif "e" in value_str.lower():
        # On some Windows builds of Python (and possibly other platforms?) the
        # exponent is zero-padded out to, it seems, three digits.  Normalize
        # the format to pad only to two digits.
        significand, exponent = value_str.split("e")
        if exponent[0] in ("+", "-"):
            sign = exponent[0]
            exponent = exponent[1:]
        else:
            sign = ""
        value_str = f"{significand}E{sign}{int(exponent):02d}"
```

