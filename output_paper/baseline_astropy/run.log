import re
path = 'astropy/utils/misc.py'
with open(path) as f:
    content = f.read()

old = """        for key, val in dct.items():
            if (inspect.isfunction(val) and
                is_public_member(key) and
                val.__doc__ is None):
                for base in cls.__mro__[1:]:
                    super_method = getattr(base, key, None)
                    if super_method is not None:
                        val.__doc__ = super_method.__doc__
                        break
"""

new = """        for key, val in dct.items():
            if (is_public_member(key) and
                ((inspect.isfunction(val) and val.__doc__ is None) or
                 (isinstance(val, property) and val.__doc__ is None))):
                for base in cls.__mro__[1:]:
                    super_method = getattr(base, key, None)
                    if super_method is not None:
                        if isinstance(val, property):
                            dct[key] = property(val.fget, val.fset, val.fdel,
                                                super_method.__doc__)
                        else:
                            val.__doc__ = super_method.__doc__
                        break
"""

assert old in content
content = content.replace(old, new)
with open(path, 'w') as f:
    f.write(content)
print("patched")
EOF
