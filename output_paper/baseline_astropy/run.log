            "HIERARCH ESO IFM CL RADIUS = 0.009125 / "
            "[m] radius arround actuator to avoid"
        )

    def test_float_format_round_trips(self):
        """
        The formatted float string should round-trip back to the original
        value, including for values near the limits of floating point
        precision.
