import re
path = 'astropy/units/tests/test_quantity.py'
with open(path) as f:
    content = f.read()

old = """        # but we should preserve float32
        a3 = np.array([1., 2.], dtype=np.float32)
        q3 = u.Quantity(a3, u.yr)
        assert q3.dtype == a3.dtype
        # items stored as objects by numpy should be converted to float
        # by default"""

new = """        # but we should preserve float32
        a3 = np.array([1., 2.], dtype=np.float32)
        q3 = u.Quantity(a3, u.yr)
        assert q3.dtype == a3.dtype

        # and all other inexact floating-point types (see #6390)
        for dt in (np.float16, np.float32, np.float64, np.longdouble):
            a = np.array([1., 2.], dtype=dt)
            q = u.Quantity(a, u.yr)
            assert q.dtype == a.dtype

        # items stored as objects by numpy should be converted to float
        # by default"""

assert old in content
content = content.replace(old, new)
with open(path, 'w') as f:
    f.write(content)
print("done")
EOF
