from astropy.io import fits

def _pad(input):
    length = 80
    if len(input) == length:
        return input
    elif len(input) > length:
        strlen = len(input) % length
        if strlen == 0:
            return input
        else:
            return input + ' ' * (length - strlen)
    else:
        strlen = len(input) % length
        return input + ' ' * (length - strlen)

