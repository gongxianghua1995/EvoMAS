        for exp in (-60, 0, 60):
            value = (1 - 2**-53) * 2**exp
            c = fits.Card("TEST", value)
            assert float(c.value) == value
            # The string representation used in the card should parse back
            # to the same value.
            assert fits.Card.fromstring(str(c)).value == value
