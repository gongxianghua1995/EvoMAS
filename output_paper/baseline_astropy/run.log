def _split_escaped_value(s, width):
    """
    Split a string that has been escaped for a FITS string value (i.e.
    containing doubled single quotes) into chunks of at most ``width``
    characters, without splitting an escaped single quote (``''``) across
    two chunks.
    """
    words = []
    while s:
        if len(s) <= width:
            words.append(s)
            break
        # Prefer to break on a space, like _words_group.
        split_pos = s.rfind(" ", 0, width)
        if split_pos != -1:
            split = split_pos + 1
        else:
            split = width
            # Make sure we do not split a doubled single quote ('').
            while split > 0 and s[split - 1] == "'" and s[split] == "'":
                split -= 1
            # If every character up to width is part of quote pairs, we have
            # no choice but to split anyway.
            if split == 0:
                split = width
        words.append(s[:split])
        s = s[split:]
    return words
```

