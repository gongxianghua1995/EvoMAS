    @property
    def name(self):
        """Ensure that file.name is a string."""
        return repr(self.buffer)

    @property
    def mode(self):
        """Mode of the underlying file, but without the 'b' (binary) flag.

        This is needed because text is encoded when writing, and the
        underlying binary stream mode (like "rb+") would incorrectly
        advertise support for binary IO.
        """
        return self.buffer.mode.replace("b", "")

